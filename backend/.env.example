# ============================================================
#  SENTINEL Backend — Template de configuration
#  Copier ce fichier en .env et remplir les valeurs
#  NE PAS versionner le fichier .env (voir .gitignore)
# ============================================================

DATABASE_URL=sqlite:///database.db

# Mode opérationnel : true = simulateur, false = vrai hardware
SIMULATION_MODE=true

# MQTT Broker
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_DATA=sbee/devices/+/data
MQTT_TOPIC_CMD=sbee/devices/+/cmd
MQTT_TOPIC_STATUS=sbee/devices/+/status

# Clé secrète IoT — À CHANGER en production, encoder dans le firmware
DEVICE_SHARED_SECRET=CHANGER_CE_SECRET_EN_PRODUCTION

# Accélérateur de simulation (1800 = 1s équivaut à 30min)
ACCELERATION_FACTOR=1800
