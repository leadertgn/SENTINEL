# ============================================================
#  SENTINEL Frontend — .gitignore (React / Vite / Node)
# ============================================================

# ── Dépendances ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Variables d'environnement ─────────────────────────────────
.env
.env.*
!.env.example

# ── Build & Production ────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Cache Vite ───────────────────────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Cache & Logs ─────────────────────────────────────────────
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Tests ────────────────────────────────────────────────────
coverage/
.vitest/

# ── TypeScript (si migration future) ─────────────────────────
*.tsbuildinfo
